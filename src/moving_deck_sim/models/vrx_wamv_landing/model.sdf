<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="vrx_wamv_landing">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="vessel_body">
      <!-- MotionProfile 是 M2 唯一船体运动源；不启用 gravity/buoyancy/hydrodynamics。 -->
      <gravity>false</gravity>
      <inertial>
        <mass>180.0</mass>
        <inertia>
          <ixx>120.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>393.0</iyy>
          <iyz>0.0</iyz>
          <izz>446.0</izz>
        </inertia>
      </inertial>

      <!-- Official VRX WAM-V base visual, imported from the pinned upstream commit at build time. -->
      <visual name="wamv_base_visual">
        <geometry>
          <mesh>
            <uri>model://vrx_wamv_landing/meshes/WAM-V-Base.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.45 0.45 0.45 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://vrx_wamv_landing/meshes/WAM-V_Albedo.png</albedo_map>
              <normal_map>model://vrx_wamv_landing/meshes/WAM-V_Normal.png</normal_map>
              <roughness_map>model://vrx_wamv_landing/meshes/WAM-V_Roughness.png</roughness_map>
              <metalness_map>model://vrx_wamv_landing/meshes/WAM-V_Metalness.png</metalness_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Numerical collision geometry copied from VRX wamv_base.urdf.xacro. -->
      <collision name="left_float">
        <pose>-0.4 1.03 0.2 0 1.57 0</pose>
        <geometry><cylinder><length>4</length><radius>0.2</radius></cylinder></geometry>
      </collision>
      <collision name="left_mid_float">
        <pose>1.85 1.03 0.3 0 1.38 0</pose>
        <geometry><cylinder><length>0.5</length><radius>0.17</radius></cylinder></geometry>
      </collision>
      <collision name="left_front_float">
        <pose>2.3 1.03 0.4 0 1.3 0</pose>
        <geometry><cylinder><length>0.45</length><radius>0.12</radius></cylinder></geometry>
      </collision>
      <collision name="right_float">
        <pose>-0.4 -1.03 0.2 0 1.57 0</pose>
        <geometry><cylinder><length>4</length><radius>0.2</radius></cylinder></geometry>
      </collision>
      <collision name="right_mid_float">
        <pose>1.85 -1.03 0.3 0 1.38 0</pose>
        <geometry><cylinder><length>0.5</length><radius>0.17</radius></cylinder></geometry>
      </collision>
      <collision name="right_front_float">
        <pose>2.3 -1.03 0.4 0 1.3 0</pose>
        <geometry><cylinder><length>0.45</length><radius>0.12</radius></cylinder></geometry>
      </collision>

      <collision name="front_left_beam_lower">
        <pose>0.9 0.85 1.0 0.78 0 0</pose>
        <geometry><cylinder><length>0.5</length><radius>0.04</radius></cylinder></geometry>
      </collision>
      <collision name="front_right_beam_lower">
        <pose>0.9 -0.85 1.0 -0.78 0 0</pose>
        <geometry><cylinder><length>0.5</length><radius>0.04</radius></cylinder></geometry>
      </collision>
      <collision name="front_left_beam_upper">
        <pose>0.9 0.6 1.18 1.35 0 0</pose>
        <geometry><cylinder><length>0.2</length><radius>0.04</radius></cylinder></geometry>
      </collision>
      <collision name="front_right_beam_upper">
        <pose>0.9 -0.6 1.18 -1.35 0 0</pose>
        <geometry><cylinder><length>0.2</length><radius>0.04</radius></cylinder></geometry>
      </collision>

      <collision name="mid_left_beam_lower">
        <pose>-0.65 0.99 0.7 0.1 0.25 0</pose>
        <geometry><cylinder><length>0.45</length><radius>0.03</radius></cylinder></geometry>
      </collision>
      <collision name="mid_right_beam_lower">
        <pose>-0.65 -0.99 0.7 -0.1 0.25 0</pose>
        <geometry><cylinder><length>0.45</length><radius>0.03</radius></cylinder></geometry>
      </collision>
      <collision name="mid_left_beam_medium">
        <pose>-0.57 0.87 1.05 0.75 0.25 0</pose>
        <geometry><cylinder><length>0.32</length><radius>0.03</radius></cylinder></geometry>
      </collision>
      <collision name="mid_right_beam_medium">
        <pose>-0.57 -0.87 1.05 -0.75 0.25 0</pose>
        <geometry><cylinder><length>0.32</length><radius>0.03</radius></cylinder></geometry>
      </collision>
      <collision name="mid_left_beam_upper">
        <pose>-0.55 0.65 1.17 1.35 0.25 0</pose>
        <geometry><cylinder><length>0.3</length><radius>0.03</radius></cylinder></geometry>
      </collision>
      <collision name="mid_right_beam_upper">
        <pose>-0.55 -0.65 1.17 -1.35 0.25 0</pose>
        <geometry><cylinder><length>0.3</length><radius>0.03</radius></cylinder></geometry>
      </collision>

      <collision name="rear_left_beam_lower">
        <pose>-0.74 1.03 0.7 0 -0.15 0</pose>
        <geometry><cylinder><length>0.45</length><radius>0.03</radius></cylinder></geometry>
      </collision>
      <collision name="rear_right_beam_lower">
        <pose>-0.74 -1.03 0.7 0 -0.15 0</pose>
        <geometry><cylinder><length>0.45</length><radius>0.03</radius></cylinder></geometry>
      </collision>
      <collision name="rear_left_beam_medium">
        <pose>-0.79 0.91 1.05 0.75 -0.15 0</pose>
        <geometry><cylinder><length>0.32</length><radius>0.03</radius></cylinder></geometry>
      </collision>
      <collision name="rear_right_beam_medium">
        <pose>-0.79 -0.91 1.05 -0.75 -0.15 0</pose>
        <geometry><cylinder><length>0.32</length><radius>0.03</radius></cylinder></geometry>
      </collision>
      <collision name="rear_left_beam_upper">
        <pose>-0.81 0.67 1.18 1.45 -0.15 0</pose>
        <geometry><cylinder><length>0.3</length><radius>0.03</radius></cylinder></geometry>
      </collision>
      <collision name="rear_right_beam_upper">
        <pose>-0.81 -0.67 1.18 -1.45 -0.15 0</pose>
        <geometry><cylinder><length>0.3</length><radius>0.03</radius></cylinder></geometry>
      </collision>

      <collision name="left_joint">
        <pose>0.58 1.03 0.6 0 -0.6 0</pose>
        <geometry><box><size>0.65 0.2 0.1</size></box></geometry>
      </collision>
      <collision name="right_joint">
        <pose>0.58 -1.03 0.6 0 -0.6 0</pose>
        <geometry><box><size>0.65 0.2 0.1</size></box></geometry>
      </collision>
      <collision name="top_base">
        <pose>0 0 1.25 0 0 0</pose>
        <geometry><box><size>1.85 1 0.1</size></box></geometry>
      </collision>

      <!-- Project-specific supports: top_base top≈1.30 m, platform underside=1.70 m. -->
      <collision name="landing_support_front_left_collision">
        <pose>0.7 0.55 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.10 0.40</size></box></geometry>
      </collision>
      <collision name="landing_support_front_right_collision">
        <pose>0.7 -0.55 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.10 0.40</size></box></geometry>
      </collision>
      <collision name="landing_support_rear_left_collision">
        <pose>-0.7 0.55 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.10 0.40</size></box></geometry>
      </collision>
      <collision name="landing_support_rear_right_collision">
        <pose>-0.7 -0.55 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.10 0.40</size></box></geometry>
      </collision>

      <visual name="landing_support_front_left_visual">
        <pose>0.7 0.55 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.10 0.40</size></box></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material>
      </visual>
      <visual name="landing_support_front_right_visual">
        <pose>0.7 -0.55 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.10 0.40</size></box></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material>
      </visual>
      <visual name="landing_support_rear_left_visual">
        <pose>-0.7 0.55 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.10 0.40</size></box></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material>
      </visual>
      <visual name="landing_support_rear_right_visual">
        <pose>-0.7 -0.55 1.5 0 0 0</pose>
        <geometry><box><size>0.10 0.10 0.40</size></box></geometry>
        <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material>
      </visual>

      <!-- landing_deck origin is the 2.4×2.4 m platform top-surface center. -->
      <collision name="landing_deck_collision">
        <pose relative_to="landing_deck">0 0 -0.05 0 0 0</pose>
        <geometry><box><size>2.4 2.4 0.1</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="landing_deck_visual">
        <pose relative_to="landing_deck">0 0 -0.05 0 0 0</pose>
        <geometry><box><size>2.4 2.4 0.1</size></box></geometry>
        <material>
          <ambient>0.22 0.24 0.26 1</ambient>
          <diffuse>0.30 0.32 0.34 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
          <pbr><metal><roughness>0.55</roughness><metalness>0.15</metalness></metal></pbr>
        </material>
      </visual>

      <!-- ID0～ID3 保持现有多尺度近距布局；ID4～ID7 构成 Marine 独立共面远距 Board。 -->
      <visual name="aruco_marker_far_visual">
        <pose relative_to="landing_deck">0.45 0 0.001 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>0.5 0.5</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal><albedo_map>model://arucotag/arucotag.png</albedo_map></metal></pbr>
        </material>
      </visual>

      <visual name="aruco_marker_planar_id4_visual">
        <pose relative_to="landing_deck">0.78 0.78 0.002 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>0.50 0.50</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal><albedo_map>model://moving_deck/aruco_id4.pgm</albedo_map></metal></pbr>
        </material>
      </visual>

      <visual name="aruco_marker_planar_id5_visual">
        <pose relative_to="landing_deck">0.78 -0.78 0.002 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>0.50 0.50</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal><albedo_map>model://moving_deck/aruco_id5.pgm</albedo_map></metal></pbr>
        </material>
      </visual>

      <visual name="aruco_marker_planar_id6_visual">
        <pose relative_to="landing_deck">-0.78 0.78 0.002 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>0.50 0.50</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal><albedo_map>model://moving_deck/aruco_id6.pgm</albedo_map></metal></pbr>
        </material>
      </visual>

      <visual name="aruco_marker_planar_id7_visual">
        <pose relative_to="landing_deck">-0.78 -0.78 0.002 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>0.50 0.50</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal><albedo_map>model://moving_deck/aruco_id7.pgm</albedo_map></metal></pbr>
        </material>
      </visual>

      <visual name="aruco_marker_near_visual">
        <pose relative_to="landing_deck">-0.18 0 0.002 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>0.20 0.20</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal><albedo_map>model://moving_deck/aruco_id1.pgm</albedo_map></metal></pbr>
        </material>
      </visual>

      <visual name="aruco_marker_ultra_near_visual">
        <pose relative_to="landing_deck">0.05 0 0.003 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>0.04 0.04</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal><albedo_map>model://moving_deck/aruco_id2.pgm</albedo_map></metal></pbr>
        </material>
      </visual>

      <visual name="aruco_marker_contact_visual">
        <pose relative_to="landing_deck">0 0 0.004 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>0.02 0.02</size></plane></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse><specular>0.4 0.4 0.4 1</specular>
          <pbr><metal><albedo_map>model://moving_deck/aruco_id3.pgm</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>

    <frame name="landing_deck" attached_to="vessel_body">
      <pose>0 0 1.8 0 0 0</pose>
    </frame>

    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>vessel_body</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/simulation/deck/ground_truth_raw</odom_topic>
    </plugin>
  </model>
</sdf>
