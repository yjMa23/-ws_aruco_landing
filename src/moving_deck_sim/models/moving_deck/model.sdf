<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="moving_deck">
    <!-- 模型原点位于甲板表面中心，使 Ground Truth 直接表示着陆平面。 -->
    <pose>0 0 2 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="moving_deck">
      <!-- P1 只研究水平运动；禁用重力，水平接触仍由物理引擎处理。 -->
      <gravity>false</gravity>
      <inertial>
        <pose>0 0 -0.05 0 0 0</pose>
        <mass>10000</mass>
        <inertia>
          <ixx>20841.6667</ixx>
          <iyy>20841.6667</iyy>
          <izz>41666.6667</izz>
        </inertia>
      </inertial>

      <collision name="deck_collision">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>5 5 0.1</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="deck_visual">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>5 5 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.28 1</ambient>
          <diffuse>0.25 0.25 0.28 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- 远距大 Marker 偏置布置；检测器会将其位姿补偿回甲板中心。 -->
      <visual name="aruco_marker_far_visual">
        <pose>0.45 0 0.001 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.5 0.5</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://arucotag/arucotag.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 中距 Marker 偏置到甲板左侧，为中心超近距 Marker 留出几何空间。 -->
      <visual name="aruco_marker_near_visual">
        <pose>-0.18 0 0.002 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.20 0.20</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://moving_deck/aruco_id1.pgm</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 近距 Marker 轻微侧移，为中心超近距 Marker 留出几何空间。 -->
      <visual name="aruco_marker_ultra_near_visual">
        <pose>0.05 0 0.003 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.04 0.04</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://moving_deck/aruco_id2.pgm</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 最末端超近距 Marker 位于甲板中心，覆盖触地阈值附近视场。 -->
      <visual name="aruco_marker_contact_visual">
        <pose>0 0 0.004 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.02 0.02</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://moving_deck/aruco_id3.pgm</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
    </plugin>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>moving_deck</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/simulation/deck/ground_truth_raw</odom_topic>
    </plugin>
  </model>
</sdf>
