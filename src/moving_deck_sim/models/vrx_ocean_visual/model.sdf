<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="vrx_ocean_visual">
    <static>true</static>
    <link name="surface">
      <!-- Dynamic rendering only: no collision, buoyancy, hydrodynamics or force coupling. -->
      <visual name="ocean_surface_visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://vrx_ocean_visual/meshes/waterlow.dae</uri>
          </mesh>
        </geometry>
        <plugin filename="libWaveVisual.so" name="vrx::WaveVisual">
          <shader>
            <vertex>materials/programs/GerstnerWaves_vs_330.glsl</vertex>
            <fragment>materials/programs/GerstnerWaves_fs_330.glsl</fragment>
            <parameters>
              <rescale>0.125</rescale>
              <bumpScale>75 75</bumpScale>
              <hdrMultiplier>0.4</hdrMultiplier>
              <fresnelPower>5.0</fresnelPower>
              <shallowColor>0 0.12 0.22 1.0</shallowColor>
              <deepColor>0 0.045 0.16 1.0</deepColor>
            </parameters>
          </shader>
          <wavefield>
            <topic>/moving_deck_sim/wavefield/parameters</topic>
            <wave>
              <model>CWR</model>
              <number>3</number>
              <amplitude>0.06</amplitude>
              <period>4.0</period>
              <scale>1.35</scale>
              <angle>0.35</angle>
              <direction>0.25</direction>
              <steepness>0.02</steepness>
              <tau>1.5</tau>
            </wave>
          </wavefield>
        </plugin>
        <visibility_flags>8</visibility_flags>
      </visual>
    </link>
  </model>
</sdf>
