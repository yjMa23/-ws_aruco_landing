<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- Marine keeps legacy world=aruco, ENU, spherical coordinates and 250 Hz physics cadence. -->
  <world name="aruco">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.40 0.43 0.46 1</ambient>
      <background>0.58 0.70 0.80 1</background>
      <shadows>true</shadows>
      <sky/>
    </scene>

    <!-- Visual-only VRX-style ocean. Its z=0.20 m matches neutral WAM-V base water reference. -->
    <include>
      <uri>model://vrx_ocean_visual</uri>
      <pose>0 0 0.20 0 0 0</pose>
    </include>

    <!-- Independent launch dock: top surface z=0.40 m, clearly separated from the vessel. -->
    <model name="uav_launch_platform">
      <static>true</static>
      <pose>-12 0 0.30 0 0 0</pose>
      <link name="platform">
        <collision name="platform_collision">
          <geometry><box><size>4 4 0.2</size></box></geometry>
        </collision>
        <visual name="platform_visual">
          <geometry><box><size>4 4 0.2</size></box></geometry>
          <material>
            <ambient>0.32 0.32 0.34 1</ambient>
            <diffuse>0.42 0.42 0.44 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <pbr><metal><roughness>0.65</roughness><metalness>0.08</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range><linear>0</linear><constant>1</constant><quadratic>0</quadratic>
      </attenuation>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <include>
      <uri>model://vrx_wamv_landing</uri>
    </include>
  </world>
</sdf>
