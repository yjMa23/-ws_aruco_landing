<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- 与 legacy 保持 world=aruco、ENU、球面坐标和 250 Hz 物理更新。 -->
  <world name="aruco">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.55 0.70 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 纯视觉海面：无 collision，不参与船舶动力学。 -->
    <model name="ocean_visual">
      <static>true</static>
      <link name="surface">
        <visual name="ocean_surface_visual">
          <pose>0 0 -0.02 0 0 0</pose>
          <geometry>
            <plane><normal>0 0 1</normal><size>300 300</size></plane>
          </geometry>
          <material>
            <ambient>0.04 0.18 0.28 1</ambient>
            <diffuse>0.05 0.28 0.42 1</diffuse>
            <specular>0.35 0.35 0.35 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 独立静态起飞台，marine 不使用无限 ground plane。 -->
    <model name="uav_launch_platform">
      <static>true</static>
      <pose>-12 0 0.1 0 0 0</pose>
      <link name="platform">
        <collision name="platform_collision">
          <geometry><box><size>4 4 0.2</size></box></geometry>
        </collision>
        <visual name="platform_visual">
          <geometry><box><size>4 4 0.2</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range><linear>0</linear><constant>1</constant><quadratic>0</quadratic>
      </attenuation>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <include>
      <uri>model://landing_vessel</uri>
    </include>
  </world>
</sdf>
